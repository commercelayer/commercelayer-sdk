{
  "name": "@commercelayer/sdk",
  "version": "8.0.4",
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./single-client": {
      "import": {
        "types": "./lib/single-client.d.ts",
        "default": "./lib/single-client.js"
      },
      "require": {
        "types": "./lib/single-client.d.cts",
        "default": "./lib/single-client.cjs"
      }
    },
    "./bundle": {
      "import": {
        "types": "./lib/bundle-compat.d.ts",
        "default": "./lib/bundle-compat.js"
      },
      "require": {
        "types": "./lib/bundle-compat.d.cts",
        "default": "./lib/bundle-compat.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "generate": "tsx ../sdk-generator/src/generator.ts && pnpm check",
    "generate-local": "tsx ../sdk-generator/src/generator.ts --local && pnpm check",
    "lint": "biome check --enforce-assist=true",
    "check": "biome check --enforce-assist=true --write",
    "ts:check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test-local": "tsx test/spot.ts",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "javascript",
    "ecommerce",
    "jamstack",
    "commercelayer"
  ],
  "author": {
    "name": "Commerce Layer",
    "email": "development@commercelayer.io"
  },
  "license": "MIT",
  "description": "Commerce Layer Javascript SDK",
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@biomejs/biome": "catalog:",
    "@commercelayer/js-auth": "catalog:",
    "@commercelayer/sdk-generator": "workspace:*",
    "@types/debug": "catalog:",
    "@types/node": "catalog:",
    "@varlock/aws-secrets-plugin": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "json-typescript": "catalog:",
    "jsonapi-typescript": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commercelayer/commercelayer-sdk.git"
  },
  "bugs": "https://github.com/commercelayer/commercelayer-sdk/issues",
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "single-client": [
        "./lib/single-client.d.ts"
      ],
      "bundle": [
        "./lib/bundle-compat.d.ts"
      ]
    }
  }
}
