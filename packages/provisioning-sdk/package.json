{
  "name": "@commercelayer/provisioning-sdk",
  "version": "2.10.2",
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "scripts": {
    "clean": "rm -rf ./.nyc_output ./node_modules/.cache ./coverage",
    "build": "tsup",
    "generate": "tsx ../sdk-generator/src/generator.ts && pnpm check",
    "generate-local": "tsx ../sdk-generator/src/generator.ts --local && pnpm check",
    "lint": "biome check --enforce-assist=true",
    "check": "biome check --enforce-assist=true --write",
    "ts:check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "verify:pack": "publint && attw --pack ."
  },
  "keywords": [
    "javascript",
    "ecommerce",
    "jamstack",
    "commercelayer",
    "provisioning"
  ],
  "author": "Pierluigi Viti <pierluigi@commercelayer.io>",
  "license": "MIT",
  "description": "Commerce Layer Provisioning API Javascript SDK",
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.5.2",
    "@commercelayer/js-auth": "^7.4.2",
    "@commercelayer/sdk-generator": "workspace:*",
    "@types/debug": "^4.1.13",
    "@types/node": "^25.9.4",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "json-typescript": "^1.1.2",
    "jsonapi-typescript": "^0.1.3",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "repository": "github:commercelayer/commercelayer-sdk",
  "bugs": "https://github.com/commercelayer/commercelayer-sdk/issues",
  "publishConfig": {
    "access": "public"
  }
}
