# Test environment for @commercelayer/provisioning-sdk, loaded by varlock (https://varlock.dev).
#
# Secrets are kept in a single AWS Systems Manager Parameter Store parameter per
# project, whose value is a JSON object keyed by variable name:
#
#   {
#     "CL_PROVISIONING_SDK_ORGANIZATION": "...",
#     "CL_PROVISIONING_SDK_CLIENT_ID": "...",
#     "CL_PROVISIONING_SDK_CLIENT_SECRET": "...",
#     "CL_PROVISIONING_SDK_ACCESS_TOKEN_EXPIRED": "..."
#   }
#
# Each secret below reads one key out of that parameter with awsParam().
# Credentials come from the default AWS chain (AWS_PROFILE, SSO session,
# access keys, ...); the caller needs ssm:GetParameter on the parameter.
#
# Values already set in the process environment (e.g. GitHub Actions secrets)
# take precedence over this file, so CI needs no AWS access.
#
# @defaultSensitive=false
# @defaultRequired=infer
# @generateTsTypes(path=test/env.d.ts)
# @plugin(@varlock/aws-secrets-plugin)
# @initAws(region=eu-west-1)
# ---

# Parameter Store parameter holding this project's secrets.
# @internal
AWS_SSM_PARAMETER=/dev/provisioning-sdk

CL_PROVISIONING_SDK_ORGANIZATION=awsParam(ref(AWS_SSM_PARAMETER), key="CL_PROVISIONING_SDK_ORGANIZATION")

# API domain, when not the default commercelayer.io.
# @optional
CL_PROVISIONING_SDK_DOMAIN=

# Token scope; empty for the default.
# @optional
CL_PROVISIONING_SDK_SCOPE=

# @sensitive
CL_PROVISIONING_SDK_CLIENT_ID=awsParam(ref(AWS_SSM_PARAMETER), key="CL_PROVISIONING_SDK_CLIENT_ID")

# @sensitive
CL_PROVISIONING_SDK_CLIENT_SECRET=awsParam(ref(AWS_SSM_PARAMETER), key="CL_PROVISIONING_SDK_CLIENT_SECRET")

# Expired token, for refresh-token tests.
# @sensitive
CL_PROVISIONING_SDK_ACCESS_TOKEN_EXPIRED=awsParam(ref(AWS_SSM_PARAMETER), key="CL_PROVISIONING_SDK_ACCESS_TOKEN_EXPIRED")
