{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      // Dev-time only: typecheck and editor resolution against a real target
      // rather than a synthetic stub, which models the generic field/sort maps
      // too narrowly and produces errors no real binding hits. Creates no
      // dependency — the runtime ships bundled into whichever package builds it.
      "#registry": ["../core/src/registry.ts"],
      "@runtime/*": ["./src/*.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
