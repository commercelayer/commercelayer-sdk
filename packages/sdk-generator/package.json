{
  "name": "@commercelayer/sdk-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generates the Commerce Layer SDKs from each target's public resources schema. Not published.",
  "exports": {
    "./target": "./src/target.ts",
    "./*": "./src/*.ts"
  },
  "bin": {
    "sdk-generate": "./src/generator.ts"
  },
  "scripts": {
    "test": "vitest run",
    "ts:check": "tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
