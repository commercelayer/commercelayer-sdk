{
  "name": "@commercelayer/sdk-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Commerce Layer SDK monorepo",
  "license": "MIT",
  "author": "Pierluigi Viti <pierluigi@commercelayer.io>",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "ts:check": "pnpm --stream -r ts:check",
    "generate": "pnpm -r generate",
    "clean": "pnpm -r clean",
    "lint": "biome check --enforce-assist=true",
    "check": "biome check --enforce-assist=true --write",
    "release": "pnpm upgrade && pnpm lint && pnpm build && pnpm test",
    "release:version": "lerna version --no-git-tag-version && node scripts/finish-version.mjs",
    "release:publish": "lerna publish from-package --dist-tag beta --yes",
    "dep:major": "pnpm dlx npm-check-updates --packageFile '**/package.json' -u",
    "dep:semver": "pnpm dlx npm-check-updates -t semver --packageFile '**/package.json' -u",
    "verify:surface": "node scripts/compare-public-surface.mjs",
    "prerelease:check": "pnpm -r build && pnpm -r verify:pack && node scripts/compare-public-surface.mjs packages/core-sdk"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "lerna": "^10.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": "github:commercelayer/commercelayer-sdk",
  "bugs": "https://github.com/commercelayer/commercelayer-sdk/issues"
}
