{
  "name": "@commercelayer/sdk-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Commerce Layer SDK monorepo",
  "license": "MIT",
  "author": {
    "name": "Commerce Layer",
    "email": "development@commercelayer.io"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "ts:check": "pnpm --stream -r ts:check",
    "generate": "pnpm -r generate",
    "clean": "pnpm dlx rimraf --glob **/node_modules **/pnpm-lock.yaml",
    "lint": "biome check --enforce-assist=true",
    "check": "biome check --enforce-assist=true --write",
    "release": "pnpm upgrade && pnpm lint && pnpm build && pnpm test",
    "release:version": "pnpm lerna version --no-git-tag-version --no-private && node scripts/finish-version.mjs",
    "dep:major": "pnpm dlx npm-check-updates --workspaces --root -u",
    "dep:semver": "pnpm dlx npm-check-updates --workspaces --root -u -t semver",
    "verify:surface": "node scripts/compare-public-surface.mjs",
    "prerelease:check": "pnpm -r build && node scripts/compare-public-surface.mjs packages/core-sdk",
    "lerna": "pnpm dlx --package=@lerna-lite/cli@5.6.4 --package=@lerna-lite/version@5.6.4 --package=@lerna-lite/publish@5.6.4 lerna"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commercelayer/commercelayer-sdk.git"
  },
  "bugs": "https://github.com/commercelayer/commercelayer-sdk/issues"
}
